{
  "name": "unbound-editor",
  "version": "1.0.3",
  "description": "A word processor that never breaks into pages. Saves as Word (.docx); opens .docx, Markdown and plain text.",
  "license": "GPL-3.0-only",
  "author": "Robbie Perdue",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:pkgname": "node scripts/check-pkgname.mjs",
    "test:e2e": "playwright test",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:linux": "bash scripts/build-linux.sh",
    "dist:mac": "electron-builder --mac dmg zip --publish never"
  },
  "dependencies": {
    "@tiptap/core": "^3.26.0",
    "@tiptap/extension-color": "^3.26.0",
    "@tiptap/extension-font-family": "^3.26.0",
    "@tiptap/extension-highlight": "^3.26.0",
    "@tiptap/extension-image": "^3.26.0",
    "@tiptap/extension-subscript": "^3.26.0",
    "@tiptap/extension-superscript": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/extension-text-align": "^3.26.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/pm": "^3.26.0",
    "@tiptap/starter-kit": "^3.26.0",
    "@turbodocx/html-to-docx": "^1.21.0",
    "mammoth": "^1.12.0",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.5",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.crperdue.unbound",
    "productName": "Unbound",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Unbound"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office",
      "synopsis": "A word processor that never breaks into pages",
      "description": "Unbound is a word processor with no pages: no print option, no PDF, no page breaks. One continuous column that scrolls as far as you need. Saves as Word (.docx); opens .docx, Markdown and plain text.",
      "maintainer": "CTEC DragonForge Team <crperdue@gmail.com>",
      "executableName": "unbound-editor",
      "desktop": {
        "entry": {
          "Name": "Unbound",
          "Comment": "A word processor that never breaks into pages. Saves .docx; opens .docx, Markdown and text.",
          "Categories": "Office;WordProcessor;",
          "Keywords": "writing;word processor;editor;docx;markdown;txt;",
          "MimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document;text/markdown;text/plain;"
        }
      }
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "appId": "com.crperdue.unbound",
  "productName": "Unbound",
  "homepage": "https://github.com/crperdue73/Unbound",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crperdue73/Unbound.git"
  }
}
